{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "https://mbti-form.112405025.workers.dev/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://mbti-form.112405025.workers.dev/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/app.(.*).js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sounds/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
